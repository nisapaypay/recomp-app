# RECOMP environment variables
# Copy to .env.local for local development (never commit .env.local).
# Set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (browser-safe; data is protected by Row Level Security) ---
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- App URL (used for password-reset redirect links) ---
# Local: http://localhost:3000   Production: https://<your-project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets ---
# Not required by the app. Never prefix with NEXT_PUBLIC_ and never expose to
# the browser. Only add if a future server-only admin task genuinely needs it.
# SUPABASE_SECRET_KEY=
